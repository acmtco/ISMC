        "operationId": "replay_endpoint_api_objects__object_id__replay_get",
        "parameters": [
          {
            "name": "object_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Object Id"
            }
          },
          {
            "name": "speed",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
