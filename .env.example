# Режим работы: replay (предзаписанные снимки, безопасно для демо) | live (реальная камера)
HG_MODE=replay

# Каталоги
HG_DATA_DIR=./data
HG_CONFIG_DIR=./config

# Хранилище: SQLite (dev) или PostgreSQL (prod)
HG_DB_URL=sqlite:///./data/hronograf.db

# API
HG_API_HOST=0.0.0.0
HG_API_PORT=8000
HG_API_URL=http://localhost:8000

# Web
HG_WEB_PORT=5173

# Объект по умолчанию (для CLI-скриптов и демо)
HG_OBJECT_ID=OBJ-001

# Скорость «машины времени» в режиме replay (Х раз быстрее реального времени)
HG_REPLAY_SPEED=60

# Логирование
HG_LOG_LEVEL=INFO
