# Caddy получает и продлевает сертификат Let's Encrypt автоматически:
# достаточно, чтобы домен указывал на этот сервер, а порты 80 и 443 были
# открыты. Отдельный certbot и задания cron не нужны.

{$HG_DOMAIN} {
	encode zstd gzip

	# Всё приложение отвечает с одного адреса: и интерфейс, и API.
	reverse_proxy app:8000

	log {
		output stdout
		format console
	}
}
